# Public site URL without a trailing slash, used by robots.txt and sitemap.xml (default: http://localhost:3005).
NEXT_PUBLIC_SITE_URL=
# AdSense client ID (ca-pub- followed by 16 digits); empty disables the AdSense code and ads.txt.
NEXT_PUBLIC_ADSENSE_CLIENT=
# Contact email shown on /contato; empty hides the mailto link.
NEXT_PUBLIC_CONTACT_EMAIL=aldocostasantos@gmail.com
