# MongoDB connection string
MONGODB_URI=mongodb://localhost:27017/safenote

# HTTP port
PORT=3000

# Environment: development | production | test
NODE_ENV=development

# Log level (comma-separated): error,warn,log,debug,verbose
LOG_LEVEL=debug,log,warn,error,verbose

# Trust proxy configuration (for rate limiting behind reverse proxy/load balancer)
# Set to 'true' or specify proxy IPs/subnets (e.g., 'loopback', 'uniquelocal')
TRUST_PROXY=
